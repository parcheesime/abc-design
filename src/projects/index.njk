---
{% set pageHero = {
  id: "projects-title",
  eyebrow: "Selected Work",
  title: "Residential & Commercial Projects",
  text: "Custom homes, remodels, ADUs, and commercial spaces throughout San Diego County."
} %}
{% include "page-hero.njk" %}

<section class="section projects-section" aria-labelledby="projects-list-title">
  <div class="container">
    <h2 id="projects-list-title" class="visually-hidden">Project list</h2>
    <div class="grid grid-2 projects-grid">
      {% for project in placeholderProjects %}
        <article class="card project-card">
          {% if project.imagePath %}
            <div class="project-card__image">
              <object
                class="project-card__image-object"
                data="{{ project.imagePath }}"
                type="image/webp"
                aria-label="{{ project.title }} project image"
              >
                <span>Project image coming soon</span>
              </object>
            </div>
          {% else %}
            <div class="project-card__image project-card__image--placeholder">
              <span>Project image coming soon</span>
            </div>
          {% endif %}

          <div class="stack stack-sm project-card__body">
            <div class="cluster project-card__meta" aria-label="Project classification">
              <span class="eyebrow">{{ project.category }}</span>
              <span>{{ project.type }}</span>
            </div>
            <h3 class="card-title project-card__title">{{ project.title }}</h3>
            <p class="card-text">Project details and gallery coming soon.</p>
            <p class="project-card__status">Project page in progress</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
