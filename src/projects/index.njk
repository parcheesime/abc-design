---
layout: layout.njk
title: Projects
permalink: /projects/
---
{% set pageHero = {
  id: "projects-title",
  eyebrow: "Selected Work",
  title: "Residential & Commercial Projects",
  text: "Custom homes, remodels, ADUs, and commercial spaces throughout San Diego County."
} %}
{% include "page-hero.njk" %}

<section class="section projects-section" aria-labelledby="projects-list-title">
  <div class="container">
    <h2 id="projects-list-title" class="visually-hidden">Project list</h2>
    <div class="grid grid-2 projects-grid">
      {% for project in selectedProjects %}
        <a class="card project-card" href="{{ ('/projects/' + project.slug + '/') | url }}">
          <div class="project-card__image">
            <img
              class="project-card__image-object"
              src="{{ ('/assets/images/projects/' + project.assetFolder + '/' + project.coverImage) | url }}"
              alt="{{ project.title }}"
              loading="lazy"
            >
          </div>
          <div class="stack stack-sm project-card__body">
            <p class="eyebrow project-card__meta">{{ project.category }}</p>
            <h3 class="card-title project-card__title">{{ project.title }}</h3>
            <p class="card-text">{{ project.projectType }}</p>
            <span class="button-text project-card__link">View Project &rarr;</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
