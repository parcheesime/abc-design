---
layout: layout.njk
title: Services
description: Explore ABC Design's residential and commercial building design, permit planning, and construction drawing services for projects throughout San Diego County.
---
{% set pageHero = {
  id: "services-title",
  title: "Services"
} %}
{% include "page-hero.njk" %}

{% set serviceRows = [
  {
    id: "residential",
    title: "Residential Design",
    description: "From single-room additions to complete home transformations, ABC Design creates permit-ready residential plans tailored to the way homeowners live. Projects include whole-house remodels, room additions, detached ADUs, multi-family units, and custom renovations that improve functionality while respecting neighborhood character. Every project is developed with careful attention to site planning, structural coordination, energy compliance, and City of San Diego permitting, helping clients move confidently from concept to construction.",
    icon: "residential.svg"
  },
  {
    id: "commercial",
    title: "Commercial Design",
    description: "ABC Design has extensive experience transforming existing commercial spaces into functional businesses that meet building, accessibility, and health department requirements. From neighborhood coffee shops to full-service restaurants, projects include tenant improvements, commercial kitchens, equipment layouts, ADA accessibility upgrades, life-safety coordination, and complete construction documents for permitting. Each design balances operational efficiency with code compliance so business owners can focus on opening their doors.",
    icon: "commercial.svg"
  },
  {
    id: "adu",
    title: "ADUs",
    description: "ABC Design develops additions and accessory dwelling units that integrate with the existing property. Services include site planning, architectural design, permit drawings, consultant coordination, structural and energy compliance, and complete construction documentation. From detached ADUs to significant rear additions and complete home expansions, each project is designed to maximize space while navigating California's evolving residential building requirements.",
    icon: "adu.svg"
  },
  {
    id: "plans-permits",
    title: "Plans & Permits",
    description: "Navigating the permitting process can be one of the most challenging parts of a construction project. ABC Design prepares complete permit-ready construction documents that coordinate architectural, structural, civil, mechanical, electrical, plumbing, and energy requirements into a clear and organized drawing set. With experience across residential remodels, commercial tenant improvements, restaurants, ADUs, and multi-family developments, the focus is on producing accurate documentation that helps projects move efficiently through plan review and into construction.",
    icon: "plans.svg"
  },
  {
    id: "project-management",
    title: "Project Management",
    description: "Construction oversight, contractor coordination, site visits, and project guidance to help keep your build on track from permit approval through completion.",
    icon: "management.svg"
  }
] %}

<section class="section service-list-section" aria-label="Building design services">
  <div class="container service-list-section__inner">
    <div class="service-list">
      {# Replace Contact links when category-specific destinations become available. #}
      {% for service in serviceRows %}
        <article class="service-list__item" id="{{ service.id }}">
          <img
            class="service-list__icon"
            src="{{ ('/assets/images/icons/' + service.icon) | url }}"
            alt=""
            width="56"
            height="56"
          >
          <div class="service-list__content">
            <h2 class="service-list__title">{{ service.title }}</h2>
            <p class="service-list__description">{{ service.description }}</p>
          </div>
          <a
            class="service-list__link"
            href="{{ '/contact/' | url }}"
            data-analytics-cta="Learn More"
            data-analytics-location="Services"
          >
            Learn More <span class="service-list__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="cta-section" aria-labelledby="services-projects-title">
  <div class="container">
    <div class="cta-section__inner">
      <div class="stack stack-sm">
        <h2 id="services-projects-title">See these services in practice.</h2>
        <p>Explore residential and commercial work completed throughout San Diego County.</p>
      </div>
      <a
        class="service-list__link cta-section__link"
        href="{{ '/projects/' | url }}"
        data-analytics-cta="View Projects"
        data-analytics-location="Services projects CTA"
      >
        View Projects <span class="service-list__arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
