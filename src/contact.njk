---
layout: layout.njk
title: Contact
description: Tell ABC Design about your San Diego residential or commercial project, including the site, scope, and timing, to begin a building design conversation.
---
{% set pageHero = {
  id: "contact-title",
  title: "Tell Rick about your project.",
  text: "Share the site, scope, and timing you have in mind. A few clear details are enough to begin the conversation."
} %}
{% include "page-hero.njk" %}

<section class="section contact-section" aria-label="Contact details and form">
  <div class="container contact-layout">
    <aside class="contact-summary">
      <div class="stack">
        <div class="section-heading">
          <h2>Project inquiries</h2>
          <p>
            ABC Design works with homeowners, business owners, and project teams throughout San Diego County.
          </p>
        </div>

        <dl class="contact-list">
          <div>
            <dt>Phone</dt>
            <dd><a href="tel:+16199926337">(619) 992-6337</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href="mailto:trepte.abcdesign@gmail.com">trepte.abcdesign@gmail.com</a></dd>
          </div>
          <div>
            <dt>Service area</dt>
            <dd>San Diego County</dd>
          </div>
        </dl>
      </div>
    </aside>

    <div class="contact-form-panel">
      <form
        class="contact-form"
        action="https://formspree.io/f/maewwqnv"
        method="post"
        data-contact-form
        data-success-url="{{ '/thank-you/' | url }}"
      >
        <input type="hidden" name="_subject" value="New ABC Design project inquiry">

        <div class="form-field visually-hidden" aria-hidden="true">
          <label for="company">Company</label>
          <input
            id="company"
            name="_gotcha"
            type="text"
            tabindex="-1"
            autocomplete="off"
          >
        </div>

        <div class="form-field">
          <label for="name">Name <span class="form-required">(required)</span></label>
          <input id="name" name="name" type="text" autocomplete="name" required>
        </div>

        <div class="form-field">
          <label for="email">Email <span class="form-required">(required)</span></label>
          <input id="email" name="email" type="email" autocomplete="email" required>
        </div>

        <div class="form-field">
          <label for="phone">Phone</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel">
        </div>

        <div class="form-field">
          <label for="project-type">Project Type</label>
          <select id="project-type" name="project-type">
            <option value="">Select a project type</option>
            <option value="residential">Residential</option>
            <option value="commercial">Commercial</option>
            <option value="adu">ADU</option>
            <option value="permit-plans">Permit plans</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="form-field">
          <label for="project-location">Project Location</label>
          <input id="project-location" name="project-location" type="text" autocomplete="address-level2">
        </div>

        <div class="form-field">
          <label for="timeline">Timeline</label>
          <input id="timeline" name="timeline" type="text">
        </div>

        <div class="form-field form-field--full">
          <label for="message">Message <span class="form-required">(required)</span></label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <div class="form-actions form-field--full">
          <button class="button-primary" type="submit">Send Message</button>
        </div>
      </form>
    </div>
  </div>
</section>
