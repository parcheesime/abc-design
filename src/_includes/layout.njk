<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} | ABC Design</title>
    <link rel="icon" href="{{ '/assets/favicons/favicon.svg' | url }}" type="image/svg+xml">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/favicons/favicon-32x32.png' | url }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/favicons/favicon-16x16.png' | url }}">
    <link rel="icon" href="{{ '/assets/favicons/favicon.ico' | url }}" sizes="any">
    <link rel="apple-touch-icon" href="{{ '/assets/favicons/apple-touch-icon.png' | url }}">
    <link rel="manifest" href="{{ '/assets/favicons/site.webmanifest' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell">
      {% include "header.njk" %}
      <main id="main-content" class="site-main" tabindex="-1">
        <div class="page-wrapper">
          {{ content | safe }}
        </div>
      </main>
      {% include "footer.njk" %}
    </div>
  </body>
</html>
