---
layout: layout.njk
pagination:
  data: selectedProjects
  size: 1
  alias: project
permalink: "/projects/{{ project.slug }}/index.html"
eleventyComputed:
  title: "{{ project.title }}"
---
<article class="project-detail">
  {% if project.heroType == "drawing" %}
    <header class="project-drawing-hero">
      <img
        class="project-drawing-hero__image"
        src="{{ ('/assets/images/projects/' + project.assetFolder + '/' + project.coverImage) | url }}"
        alt="Construction drawing for {{ project.title }}"
        width="{{ project.coverWidth }}"
        height="{{ project.coverHeight }}"
      >
      <div class="project-drawing-hero__panel">
        <div class="container project-drawing-hero__panel-inner">
          {% if project.heroCategory %}<p class="eyebrow project-drawing-hero__category">{{ project.heroCategory }}</p>{% endif %}
          <h1>{{ project.title }}</h1>
          {% if project.projectType or project.location %}
            <p class="project-drawing-hero__meta">
              {% if project.projectType %}<span>{{ project.projectType }}</span>{% endif %}
              {% if project.location %}<span>{{ project.location }}</span>{% endif %}
            </p>
          {% endif %}
        </div>
      </div>
    </header>
  {% else %}
    <header class="project-detail-hero">
      <img
        class="project-detail-hero__image"
        src="{{ ('/assets/images/projects/' + project.assetFolder + '/' + project.coverImage) | url }}"
        alt="{{ project.coverAlt }}"
        width="{{ project.coverWidth }}"
        height="{{ project.coverHeight }}"
      >
      <div class="project-detail-hero__content container">
        {% if project.category %}<p class="eyebrow project-detail-hero__category">{{ project.category }}</p>{% endif %}
        <h1>{{ project.title }}</h1>
        {% if project.projectType or project.location %}
          <p class="project-detail-hero__meta">
            {% if project.projectType %}{{ project.projectType }}{% endif %}
            {% if project.projectType and project.location %}<span aria-hidden="true">&middot;</span>{% endif %}
            {% if project.location %}{{ project.location }}{% endif %}
          </p>
        {% endif %}
      </div>
    </header>
  {% endif %}

  <section class="section project-overview" aria-labelledby="project-overview-title">
    <div class="container project-overview__inner">
      <div class="project-overview__copy">
        <h2 id="project-overview-title">Project Overview</h2>
        {% if project.summary %}<p>{{ project.summary }}</p>{% endif %}
        {% for paragraph in project.description %}
          <p>{{ paragraph }}</p>
        {% endfor %}
      </div>
      <dl class="project-facts">
        {% if project.projectType %}<div><dt>Project Type</dt><dd>{{ project.projectType }}</dd></div>{% endif %}
        {% if project.category %}<div><dt>Category</dt><dd>{{ project.category }}</dd></div>{% endif %}
        {% if project.location %}<div><dt>Location</dt><dd>{{ project.location }}</dd></div>{% endif %}
        {% if project.year %}<div><dt>Year</dt><dd>{{ project.year }}</dd></div>{% endif %}
        {% if project.status %}<div><dt>Status</dt><dd>{{ project.status }}</dd></div>{% endif %}
      </dl>
    </div>
  </section>

  {% if project.details.length or project.highlights.length %}
    <section class="section project-scope" aria-labelledby="project-scope-title">
      <div class="container project-scope__inner">
        {% if project.details.length %}
          <div>
            <h2 id="project-scope-title">Project Details &amp; Scope</h2>
            <ul class="project-scope__list">
              {% for detail in project.details %}<li>{{ detail }}</li>{% endfor %}
            </ul>
          </div>
        {% endif %}
        {% if project.highlights.length %}
          <div>
            <h2{% if not project.details.length %} id="project-scope-title"{% endif %}>Project Highlights</h2>
            <ul class="project-scope__list">
              {% for highlight in project.highlights %}<li>{{ highlight }}</li>{% endfor %}
            </ul>
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% if project.services.length %}
  <section class="section project-services" aria-labelledby="project-services-title">
    <div class="container project-services__inner">
      <div class="project-services__heading">
        <span class="project-services__icons">
          {% for icon in project.serviceIcons %}
            <img
              src="{{ ('/assets/images/icons/' + icon.file) | url }}"
              alt=""
              width="{{ icon.width }}"
              height="{{ icon.height }}"
            >
          {% endfor %}
        </span>
        <h2 id="project-services-title">Services Provided</h2>
      </div>
      <ul class="project-services__list">
        {% for service in project.services %}
          <li>{{ service }}</li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  <nav class="project-navigation container" aria-label="Project navigation">
    {% if project.previousSlug %}
      <a href="{{ ('/projects/' + project.previousSlug + '/') | url }}">&larr; Previous Project</a>
    {% else %}<span></span>{% endif %}
    <a href="{{ '/projects/' | url }}">All Projects</a>
    {% if project.nextSlug %}
      <a href="{{ ('/projects/' + project.nextSlug + '/') | url }}">Next Project &rarr;</a>
    {% else %}<span></span>{% endif %}
  </nav>

  <section class="cta-section project-cta" aria-label="Project inquiry">
    <div class="cta-section__inner container">
      <p>ABC Design can help turn your ideas into clear, permit-ready construction plans.</p>
      <a
        class="button-primary"
        href="{{ '/contact/' | url }}"
        data-analytics-cta="Contact Rick"
        data-analytics-location="Project Detail"
      >Contact Rick</a>
    </div>
  </section>
</article>
